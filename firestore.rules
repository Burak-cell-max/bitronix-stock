rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Yardımcılar ─────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth != null && request.auth.token.email != null
        ? request.auth.token.email.lower() : '';
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function platformRole() {
      return userData().get('platformRole', 'user');
    }

    function isPlatformAdmin() {
      return isAuthenticated() && platformRole() in ['superAdmin', 'admin'];
    }

    function isSuperAdmin() {
      return isAuthenticated() && platformRole() == 'superAdmin';
    }

    function isWsMember(wid) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/workspaces/$(wid)/members/$(request.auth.uid));
    }

    function wsRole(wid) {
      return get(/databases/$(database)/documents/workspaces/$(wid)/members/$(request.auth.uid)).data.role;
    }

    function wsHas(wid, roles) {
      return isWsMember(wid) && wsRole(wid) in roles;
    }

    // Bir workspace daveti dokümanı (id = "{wid}_{email}").
    function inviteId(wid) {
      return wid + '_' + request.auth.token.email.lower();
    }
    function invitePath(wid) {
      return /databases/$(database)/documents/workspace_invites/$(inviteId(wid));
    }
    function hasPendingInvite(wid, role) {
      return request.auth.token.email != null
        && exists(invitePath(wid))
        && get(invitePath(wid)).data.status == 'pending'
        && get(invitePath(wid)).data.role == role;
    }

    function changed(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ─── Users ──────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == userId || isPlatformAdmin());

      // Kayıt: kullanıcı kendi profilini oluşturur, daima platformRole=user.
      allow create: if request.auth.uid == userId
        && request.resource.data.get('platformRole', 'user') == 'user'
        && request.resource.data.get('status', 'active') == 'active';

      // - superAdmin: her şey
      // - kullanıcı kendisi: platformRole değişmiyor VEYA 'user'a set ediliyor;
      //   status değişmiyor VEYA 'active'e set ediliyor. (Kayıt anındaki
      //   touchLastLogin ↔ createProfile yarışında bare dokümanı tamamlar,
      //   yetki yükseltmeye izin vermez.)
      // - platform admin: yalnızca `user` rolündeki hesapların DURUMUNU değiştirebilir.
      allow update: if isSuperAdmin()
        || (request.auth.uid == userId
            && (request.resource.data.get('platformRole', 'user') == resource.data.get('platformRole', 'user')
                || request.resource.data.get('platformRole', 'user') == 'user')
            && (request.resource.data.get('status', 'active') == resource.data.get('status', 'active')
                || request.resource.data.get('status', 'active') == 'active'))
        || (isPlatformAdmin()
            && resource.data.get('platformRole', 'user') == 'user'
            && !changed(['platformRole'])
            && request.resource.data.status in ['active', 'suspended', 'deleted']);

      allow delete: if isSuperAdmin();
    }

    // ─── Workspaces ─────────────────────────────────────────────────────
    match /workspaces/{wid} {
      allow read: if isWsMember(wid) || isPlatformAdmin();
      allow create: if isAuthenticated()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if wsHas(wid, ['admin']) || isSuperAdmin();
      allow delete: if isSuperAdmin();

      // ── Üyeler ──
      match /members/{memberId} {
        // Son koşul: kullanıcının kendi üyelik dokümanı — collectionGroup
        // "members where uid == myUid" sorgusunun kural tarafından
        // kanıtlanabilir olması için.
        allow read: if isWsMember(wid) || isPlatformAdmin()
          || resource.data.get('uid', '') == request.auth.uid;

        // - superAdmin / mevcut workspace admini
        // - onboarding: workspace sahibi kendini admin olarak ekler
        // - davet kabul: kendisine bekleyen bir davet olan kullanıcı, davetteki
        //   rolle kendi üyelik dokümanını oluşturur
        allow create: if isSuperAdmin()
          || wsHas(wid, ['admin'])
          || (request.auth.uid == memberId
              && request.resource.data.role == 'admin'
              && get(/databases/$(database)/documents/workspaces/$(wid)).data.ownerUid == request.auth.uid)
          || (request.auth.uid == memberId
              && hasPendingInvite(wid, request.resource.data.role));

        // Üye kendi üyeliğinden ayrılabilir; admin herkesi yönetir.
        allow update: if wsHas(wid, ['admin']) || isSuperAdmin();
        allow delete: if wsHas(wid, ['admin']) || isSuperAdmin()
          || request.auth.uid == memberId;
      }

      // ── Ürünler ──
      match /products/{productId} {
        allow read: if isWsMember(wid) || isPlatformAdmin();
        allow create: if wsHas(wid, ['admin', 'manager']);
        allow update: if wsHas(wid, ['admin', 'manager'])
          || (wsHas(wid, ['warehouse'])
              && onlyChanged(['currentStock', 'updatedAt', 'warehouseId']));
        allow delete: if wsHas(wid, ['admin']);
      }

      // ── Stok hareketleri (değiştirilemez denetim kaydı) ──
      match /stock_movements/{movementId} {
        allow read: if isWsMember(wid) || isPlatformAdmin();
        allow create: if wsHas(wid, ['admin', 'manager', 'warehouse', 'production']);
        allow update, delete: if false;
      }

      // ── Depolar ──
      match /warehouses/{warehouseId} {
        allow read: if isWsMember(wid) || isPlatformAdmin();
        allow create, update: if wsHas(wid, ['admin', 'manager']);
        allow delete: if wsHas(wid, ['admin']);
      }

      // ── Sayımlar ──
      match /stock_counts/{countId} {
        allow read: if isWsMember(wid) || isPlatformAdmin();
        allow create, update: if wsHas(wid, ['admin', 'manager', 'warehouse']);
        allow delete: if wsHas(wid, ['admin']);
      }

      // ── Finans (yalnızca admin / manager / accounting) ──
      match /finance_accounts/{accountId} {
        allow read: if wsHas(wid, ['admin', 'manager', 'accounting']) || isPlatformAdmin();
        allow create, update: if wsHas(wid, ['admin', 'manager', 'accounting']);
        allow delete: if wsHas(wid, ['admin']);
      }
      match /finance_transactions/{transactionId} {
        allow read: if wsHas(wid, ['admin', 'manager', 'accounting']) || isPlatformAdmin();
        allow create: if wsHas(wid, ['admin', 'manager', 'accounting']);
        // Güncelleme yalnızca durum (iptal) ve fatura eki alanları için.
        allow update: if wsHas(wid, ['admin', 'manager', 'accounting'])
          && onlyChanged(['status', 'invoiceUrl', 'invoiceName', 'updatedAt']);
        allow delete: if false;
      }

      // ── Diğer workspace alt koleksiyonları (suppliers, categories, …) ──
      match /suppliers/{id}   { allow read: if isWsMember(wid); allow write: if wsHas(wid, ['admin', 'manager']); }
      match /categories/{id}  { allow read: if isWsMember(wid); allow write: if wsHas(wid, ['admin', 'manager']); }
    }

    // ─── Workspace davetleri (Faz 3) ───────────────────────────────────
    // Doküman id'si "{workspaceId}_{email}" biçiminde.
    match /workspace_invites/{inviteId} {
      allow read: if isAuthenticated() && (
        resource.data.email == myEmail()
        || wsHas(resource.data.workspaceId, ['admin'])
        || isPlatformAdmin()
      );
      allow create: if wsHas(request.resource.data.workspaceId, ['admin'])
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.resource.data.email.lower();
      // Davet eden admin iptal/güncelleme yapabilir; davet edilen kişi yalnızca
      // durum alanlarını değiştirebilir (kabul/ret).
      allow update: if wsHas(resource.data.workspaceId, ['admin'])
        || (resource.data.email == myEmail()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'acceptedBy', 'acceptedAt', 'updatedAt']));
      allow delete: if wsHas(resource.data.workspaceId, ['admin'])
        || isPlatformAdmin();
    }

    // ─── Platform denetim kayıtları (Faz 2) ─────────────────────────────
    match /audit_logs/{logId} {
      allow read: if isPlatformAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // ─── LEGACY V1 global koleksiyonları ────────────────────────────────
    // Migrasyon superAdmin tarafından çalıştırılırken bu koleksiyonların
    // OKUNABİLİR olması gerekir. Migrasyon doğrulandıktan sonra bu blok
    // tamamen silinerek eski veriye erişim kapatılmalıdır.
    match /products/{id}            { allow read: if isSuperAdmin(); allow write: if false; }
    match /stock_movements/{id}     { allow read: if isSuperAdmin(); allow write: if false; }
    match /warehouses/{id}          { allow read: if isSuperAdmin(); allow write: if false; }
    match /stock_counts/{id}        { allow read: if isSuperAdmin(); allow write: if false; }
    match /finance_accounts/{id}    { allow read: if isSuperAdmin(); allow write: if false; }
    match /finance_transactions/{id}{ allow read: if isSuperAdmin(); allow write: if false; }
    match /settings/{id}            { allow read: if isAuthenticated(); allow write: if isSuperAdmin(); }
  }
}
